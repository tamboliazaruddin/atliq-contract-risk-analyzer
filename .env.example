# Copy to .env.local and fill in. Never commit .env.local.
# LLM provider for the AI clause analysis: "groq" (OpenAI-compatible API) or "anthropic".
# With no key the app still runs: deterministic checks only, reviews clearly marked "incomplete".
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high (gpt-oss reasoning effort; medium is the default)
LLM_REASONING_EFFORT=medium
# Prompt budget per AI call (tokens). Groq's free tier allows ~8k tokens per minute, so keep this ~4300.
LLM_MAX_INPUT_TOKENS=4300

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# "Today" for expiry / deadline logic in the synthetic dataset
DATASET_TODAY=2026-09-28

# Session signing secret (min 32 chars). `npm run users` generates one into .env.local.
AUTH_SECRET=
